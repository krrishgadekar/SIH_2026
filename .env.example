# NetraSetu -- local development configuration template.
#
# Copy to `.env` in the repo root and fill in real values. `.env` is git-ignored;
# this file is committed and must never contain a real secret. Both backends
# (central-system/backend and phc-local-app/backend) read the same root .env.

# ── Central Postgres ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/dr_screening_central

# ── MATLAB ───────────────────────────────────────────────────────────────────
# Forward slashes deliberately: Windows accepts them, and they avoid backslash
# mangling in .env parsers and MATLAB string literals alike.
MATLAB_EXECUTABLE=C:/Program Files/MATLAB/R2026a/bin/matlab.exe
MATLAB_TIMEOUT_MS=600000
# matlab (default) | python
INFERENCE_BACKEND=matlab
PYTHON_EXECUTABLE=python

# ── Auth (backend plan §A) ───────────────────────────────────────────────────
# Browser logins for ophthalmologist / district_admin. OFF until the frontends
# ship their login screens; login itself works either way.
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session length in hours, 12-24 recommended (no refresh tokens).
JWT_TTL_HOURS=12
# lax for a same-site frontend; none when the frontend is on another site
# (e.g. a *.vercel.app page calling this laptop), which also forces Secure.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# Minutes a reviewer's claim on a case holds before someone else may take it.
CLAIM_TTL_MINUTES=30

# PHC device keys on the ingestion routes. Provision every PHC first:
#   cd central-system/backend && npm run provision-phc-key -- --phc-id <uuid>
PHC_AUTH_ENABLED=false

# TLS for the central backend (§A.14). Generate a self-signed demo pair with
#   node scripts/generateDevCert.js
# which prints these lines. Unset = plain HTTP (fine for localhost only).
# TLS_KEY_PATH=
# TLS_CERT_PATH=
# On the PHC backend, trust that certificate instead of disabling checks:
# NODE_EXTRA_CA_CERTS=certs/dev-cert.pem

# Browser origins allowed to call the central API (comma-separated).
# Unset = localhost dev ports + https://*.vercel.app.
# CORS_ALLOWED_ORIGINS=https://netrasetu.vercel.app,http://localhost:5173

# ── Reliability (backend plan §D-§F) ────────────────────────────────────────
# Periodic re-queue of grading jobs that lost their worker (§D).
# GRADING_WATCHDOG_INTERVAL_MS=90000
# WATCHDOG_MIN_AGE_SECONDS=120
# WATCHDOG_MAX_RECOVERIES=3
# Supervisor for the persistent MATLAB session (§E). On by default whenever
# INFERENCE_BACKEND=matlab; it also STARTS the session when the backend boots.
# MATLAB_SUPERVISOR_ENABLED=true
# MATLAB_SUPERVISOR_INTERVAL_MS=30000
# MATLAB_HEARTBEAT_STALE_MS=30000
# MATLAB_STARTUP_GRACE_MS=240000
# MATLAB_MAX_RESTARTS=3
# System Health thresholds (§F).
# SILENT_PHC_HOURS=48
# STUCK_JOB_MINUTES=15
# UNREVIEWED_CASE_HOURS=48

# ── Demo accounts (scripts/seedDemoUsers.js) ─────────────────────────────────
# CLEARLY FAKE demo credentials, not anyone's real account. Change the
# passwords before any demo on a network you do not control.
#   ophthalmologist@demo.netrasetu.local / DemoOphth-2026
#   admin@demo.netrasetu.local           / DemoAdmin-2026
# DEMO_OPHTHALMOLOGIST_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# 1 = log messages instead of sending them
SMS_DRY_RUN=1
REFERRAL_CLINIC_NAME=

# ── PHC local app (phc-local-app/backend) ────────────────────────────────────
CENTRAL_URL=http://localhost:5000
# This site's phc_sites.phc_id on central, and the key printed when it was
# provisioned. The key is a secret: it lives only in this PHC's .env.
PHC_ID=
PHC_API_KEY=
PHC_CODE=PHC001
